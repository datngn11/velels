# Environment variables

# Public origin of the site, without a trailing slash. Drives metadataBase, the
# OpenGraph urls, every canonical, the Product JSON-LD offer url, and the
# "via <host>" signature on the Instagram Direct message.
NEXT_PUBLIC_SITE_URL="https://velels.com"

# Indexing is opt-in and fails closed. Set to "true" on the production build only.
# NEXT_PUBLIC_ALLOW_INDEXING="true"

# Umami Cloud website id, from the dashboard. A build-time variable: it is inlined
# into the HTML by `next build`, so setting it in Cloudflare's Worker runtime
# variables does nothing. Omit it and the analytics snippet is not rendered.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
