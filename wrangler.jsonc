{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "velels",
  "compatibility_date": "2026-08-28",

  // The apex as a Custom Domain, declared here rather than clicked in the
  // dashboard so it reapplies on every deploy. This is the `custom_domain` form,
  // not `route` + `zone_name`: that one routes a script at a URL pattern, which
  // is not what a whole-site static deploy wants.
  //
  // Custom Domains match the exact hostname, so this does not catch
  // `www.velels.com`. That stays a dashboard redirect rule to the apex, which
  // keeps one canonical hostname rather than serving the site on two.
  //
  // If a second Worker is ever added, its environment needs `"routes": []`.
  // `routes` is inheritable, so a named environment without that line inherits
  // this domain and its deploy reassigns `velels.com` away from production.
  // Wrangler warns, in output nobody reads twice.
  "routes": [{ "pattern": "velels.com", "custom_domain": true }],

  // Off since 2026-09-21, once velels.com answered. Removing the hostname beats
  // asking crawlers not to index it, and it also removes a second copy of the
  // whole site. Turn it back on only if the apex ever needs bypassing to debug a
  // deploy.
  "workers_dev": false,

  // Every branch build gets a link to open on a phone before merge (post-launch
  // G8): `<branch>-velels.<subdomain>.workers.dev`, posted on the PR. Branch
  // builds get no build variables, so those pages say `noindex`, keep their
  // canonical on velels.com and load no analytics. Applied by `wrangler deploy`,
  // so a change here reaches previews only after it is merged.
  "preview_urls": true,

  // No `main`: this is an assets-only Worker. There is no Worker script, so no
  // code runs on a page view and static-asset requests are free and unlimited.
  "assets": {
    "directory": "./out",

    // Default is "none", which serves a bare Cloudflare error page. "404-page"
    // serves out/404.html with a real 404 status.
    // Never "single-page-application": it returns 200 for every unmatched path,
    // which would feed the index duplicate homepages.
    "not_found_handling": "404-page",

    // Already the default, pinned so a future default change cannot silently
    // rewrite every URL. Serves out/uk/product/azure.html at /uk/product/azure.
    "html_handling": "auto-trailing-slash"
  }
}
